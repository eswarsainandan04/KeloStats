# Environment Variables & Secrets (CRITICAL)
.env
*.env
.env.*
!.env.example

# Python bytecode & cache
__pycache__/
**/__pycache__/
**/__pycache__/*
*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS Generated files
.DS_Store
Thumbs.db

# Dependencies & Build Artefacts
node_modules/
**/node_modules/
.next/
**/.next/
*.tsbuildinfo

# Scratch & Temporary Testing Folders (CRITICAL)
scratch/
**/scratch/
backend/scratch/

# Runtime Logs, Test Dumps, Storage & Media
backend/logs/llm_logs/
backend/app/logs/llm_logs/
**/llm_logs/
*.log
backend/data/*.json
backend/app/services/agents/data/
**/agents/data/
backend/*.pptx
backend/slide3_dump.html
backend/canvas_screenshot.png
# Local file storage folders (do NOT ignore app/core/storage python code)
/backend/storage/
backend/storage/
!backend/app/core/storage/
!backend/app/core/storage/*.py

# Large Media Files (CRITICAL)
*.mp4
*.mkv
*.mov
final_kelostats.mp4

