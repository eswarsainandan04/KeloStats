# Application Metadata Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# JWT Authentication Configuration (Realtime Access & Refresh Tokens)
JWT_SECRET_KEY=your_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# General LLM Provider Configuration (Groq / OpenAI compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your_groq_api_key_here

# PPT Generation LLM
PPT_GENERATION_LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
PPT_GENERATION_LLM_MODEL=z-ai/glm-5.3-flash
PPT_GENERATION_LLM_API_KEY=your_openrouter_api_key_here

# Planning LLM
PLANNING_LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
PLANNING_LLM_MODEL=z-ai/glm-5.3-flash
PLANNING_LLM_API_KEY=your_openrouter_api_key_here

# Storage Mode (local or cloud)
STORAGE_MODE=cloud

# Universal S3 Cloud Storage (Required only if STORAGE_MODE=cloud)
S3_ENDPOINT_URL=https://your-project.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=storage

# Google Gemini Embedding (for pgvector RAG)
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-2
